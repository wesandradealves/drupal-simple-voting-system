# Composer-managed dependencies
/vendor/
/web/core/
/web/libraries/
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/
/drush/Commands/contrib/

# Local environment
/.env

# Site settings and user-generated files
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/files/
/web/sites/simpletest/

# Scaffold files regenerated by composer
/.gitattributes
/recipes/README.txt
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/modules/README.txt
/web/profiles/README.txt
/web/themes/README.txt
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php

# Local, machine-specific Lando overrides.
/.lando.local.yml

# Generated by Composer, not scaffolded.
/web/autoload.php
/web/autoload_runtime.php
/web/web.config
/recipes/
/.gitattributes

# Written by Drupal when it secures the directory.
/config/sync/.htaccess

# Local working notes and approval mockups. Never committed.
/.scratch/

.codegraph/
