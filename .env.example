# Simple Voting System - local environment template.
# Copy to .env and adjust the ports if they clash with something already running.
# Every credential below is a DEVELOPMENT-ONLY throwaway value. This stack is not
# hardened and must never be exposed to a public network or reused in production.

# --- Compose ---

# Prefix for container, network and volume names, and for the built PHP image.
COMPOSE_PROJECT_NAME=simple-voting-system

# Profiles started by default. "tools" adds Adminer and Mailpit; add "dev" for the Sass watcher.
COMPOSE_PROFILES=tools

# --- Ports (host side) ---

# Host port serving the Drupal site through Nginx.
HTTP_PORT=8081

# Host port serving the Adminer database client.
ADMINER_PORT=8082

# Host port serving the Mailpit web inbox.
MAILPIT_PORT=8025

# --- Host user mapping ---

# Host user id owning the bind-mounted files; the PHP image runs as this id to keep write permissions sane.
APP_UID=1000

# Host group id used together with APP_UID.
APP_GID=1000

# --- PHP / toolchain ---

# PHP minor version used as the base image tag for the php service.
PHP_VERSION=8.4

# Dart Sass release compiled into the PHP image and used by the sass watcher.
SASS_VERSION=1.103.1

# Xdebug activation: "off" for full speed, "debug" to step through code, "coverage" for reports.
XDEBUG_MODE=off

# Address Xdebug calls back to reach the IDE on the host.
XDEBUG_CLIENT_HOST=host.docker.internal

# --- Database ---

# Hostname of the MariaDB service on the Compose network.
DB_HOST=db

# Database created on first boot and used by Drupal.
DB_NAME=drupal

# Application database user.
DB_USER=drupal

# Password for the application database user.
DB_PASSWORD=drupal

# MariaDB root password, used for administrative tasks only.
DB_ROOT_PASSWORD=root

# --- Drupal install ---

# Site name written during installation.
DRUPAL_SITE_NAME=Simple Voting System

# Username of the first administrator account.
DRUPAL_ACCOUNT_NAME=admin

# Password of the first administrator account.
DRUPAL_ACCOUNT_PASS=admin

# Email address of the first administrator account.
DRUPAL_ACCOUNT_MAIL=admin@example.com

# Absolute site URL; also exported as DRUSH_OPTIONS_URI so Drush generates correct links.
DRUPAL_BASE_URL=http://localhost:8081

# Installation profile passed to drush site:install.
DRUPAL_INSTALL_PROFILE=standard
