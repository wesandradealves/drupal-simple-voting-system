<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for the Voting module.
 */

use Drupal\drupal_simple_voting\PollSeeder;
use Drupal\Core\Url;
use Drupal\user\UserInterface;

/**
 * Implements hook_user_presave().
 *
 * Registration is open and every account that comes through it is here to
 * vote, so the role is granted while the account is still being written.
 * hook_user_insert() would run after the save and the change would be lost.
 */
function drupal_simple_voting_user_presave(UserInterface $account): void {
  if (!$account->isNew() || $account->hasRole(PollSeeder::VOTER_ROLE)) {
    return;
  }

  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load(PollSeeder::VOTER_ROLE);
  if ($role !== NULL) {
    $account->addRole(PollSeeder::VOTER_ROLE);
  }
}

/**
 * Implements hook_gin_content_form_routes().
 */
function drupal_simple_voting_gin_content_form_routes(): array {
  // The delete form is deliberately absent: gin.api.php states that not every
  // content entity form route should take the edit layout, and names the
  // delete form as the counter-example.
  return [
    'entity.voting_question.add_form',
    'entity.voting_question.edit_form',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for Gin's content navigation.
 *
 * Gin builds the block at the top of its sidebar from a hardcoded list of
 * entity types — content, blocks, files, media — and never reads the menu, so
 * a module cannot reach it with a menu link. On a site whose content is polls
 * that block would otherwise show Blocks and Files alone, with no way in to
 * the polls at all.
 */
function drupal_simple_voting_preprocess_menu_region__middle(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'content') {
    return;
  }

  $url = Url::fromRoute('entity.voting_question.collection');
  if (!$url->access()) {
    return;
  }

  $variables['items']['polls'] = [
    'title' => t('Polls'),
    'class' => 'polls',
    'url' => $url->toString(),
  ];

  // The kill switch rides in the same sidebar block, right beside the polls it
  // closes. Its route lives under Configuration, but an administrator manages
  // the polls from here and expects to open or close voting from here too.
  $settings_url = Url::fromRoute('drupal_simple_voting.settings');
  if ($settings_url->access()) {
    $variables['items']['voting_settings'] = [
      'title' => t('Voting settings'),
      'class' => 'voting-settings',
      'url' => $settings_url->toString(),
    ];
  }
}
